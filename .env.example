# Optional hybrid profile. Empty values select local extraction.
# O2J_API_BASE=https://api.scaleway.ai/v1
# O2J_MODEL=mistral/mistral-small-3.2-24b-instruct-2506:fp8
# O2J_API_KEY=

# For Linux Compose bind mounts, set these to the IDs of the current account if needed.
# O2J_UID=1000
# O2J_GID=1000
